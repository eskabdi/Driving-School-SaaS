# Supabase — public by design (safe to expose to the browser).
# Copy this file to `.env` and fill in your project values.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Observability
VITE_SENTRY_DSN=
VITE_APP_VERSION=dev

# Cloudflare Turnstile (public site key; secret lives in Supabase Vault)
VITE_TURNSTILE_SITE_KEY=
